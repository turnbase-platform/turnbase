# core.autocrlf=true is set in this environment, which rewrites LF to CRLF on
# checkout. For a shell script that is fatal and the error is unhelpful — bash
# reports `\r': command not found` or, for a git hook, silently refuses to run it.
# The scripts here are executed by bash on Linux and inside containers, so they
# are pinned to LF regardless of the platform's preference.
*.sh text eol=lf
.githooks/* text eol=lf

# The proto is byte-compared against turnbase-common's committed copy by
# scripts/sync-proto.sh --check. That copy is pinned to LF by the submodule's own
# .gitattributes, so if this side were left to the platform default the guard would
# report drift on every line of an identical file — a false alarm on the check whose
# whole value is that a real difference is never dismissed as noise.
*.proto text eol=lf

# Same reason, same fix, for the manifest schema byte-compared by
# scripts/sync-manifest-schema.sh --check against turnbase-platform's committed copy
# (conventions.md §5, IMP-GATE-60).
docs/specs/manifest/manifest.schema.json text eol=lf

# Maven and Gradle wrappers ship as-is; mvnw is a shell script and mvnw.cmd must
# stay CRLF for cmd.exe.
mvnw text eol=lf
mvnw.cmd text eol=crlf
gradlew text eol=lf

# Binary — never touched.
*.jar binary
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
