[submodule "turnbase-common"]
	path = turnbase-common
	url = https://github.com/turnbase-platform/turnbase-common.git
[submodule "turnbase-sdk"]
	path = turnbase-sdk
	url = https://github.com/turnbase-platform/turnbase-sdk.git
[submodule "turnbase-platform"]
	path = turnbase-platform
	url = https://github.com/turnbase-platform/turnbase-platform.git
[submodule "turnbase-game-host"]
	path = turnbase-game-host
	url = https://github.com/turnbase-platform/turnbase-game-host.git
[submodule "turnbase-frontend"]
	path = turnbase-frontend
	url = https://github.com/turnbase-platform/turnbase-frontend.git
[submodule "turnbase-game-tictactoe"]
	path = turnbase-game-tictactoe
	url = https://github.com/turnbase-platform/turnbase-game-tictactoe.git
[submodule "turnbase-game-7wonders-duel"]
	path = turnbase-game-7wonders-duel
	url = https://github.com/turnbase-platform/turnbase-game-7wonders-duel.git
	update = none
