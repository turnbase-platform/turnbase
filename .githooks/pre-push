#!/usr/bin/env bash
#
# Parent-repo pre-push fast-fail. Enable once with:
#
#   git config core.hooksPath .githooks
#
# CI is the gate; this is a fast-fail (conventions.md §4). Bypass with --no-verify
# when you know the push is a WIP branch.
#
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

fail=0

echo "pre-push: corpus checks"
python3 scripts/check-corpus.py || fail=1

# The proto drift guard lives here rather than in turnbase-common because this is
# the only checkout holding both the authoritative file and the copy.
if [[ -e turnbase-common/.git ]]; then
  echo "pre-push: proto copy"
  scripts/sync-proto.sh --check || fail=1
else
  echo "pre-push: proto copy — skipped, turnbase-common not checked out"
fi

# Same drift guard, same reason, for the manifest schema (IMP-M4-02, conventions.md §5).
# sync-manifest-schema.sh --check treats a missing copy as nothing to verify yet, so this is
# safe to run unconditionally once turnbase-platform is checked out at all.
if [[ -e turnbase-platform/.git ]]; then
  echo "pre-push: manifest schema copy"
  scripts/sync-manifest-schema.sh --check || fail=1
else
  echo "pre-push: manifest schema copy — skipped, turnbase-platform not checked out"
fi

exit $fail
